# API + indexer on Robinhood Chain mainnet. On the VPS: cp .env.mainnet.example .env, fill every CHANGE_ME, then
# npm run db:migrate -w @paritas/api && pm2 start apps/api/ecosystem.config.cjs
# Addresses are not set here: they come from deployments/4663.json (filled from Blockscout, written by Deploy.s.sol).
CHAIN_ID=4663
# Use a provider with archive logs for the indexer backfill; the public RPC is fine for /quote and reads.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
DATABASE_URL=postgresql://paritas:CHANGE_ME@127.0.0.1:5432/paritas
REDIS_URL=redis://127.0.0.1:6379
PORT=4000
# The site's origin (decision 1 in docs/DECISIONS.md). Same-origin /api through Nginx needs no CORS, but set it anyway.
CORS_ORIGINS=https://CHANGE_ME
# Keys you hand to approved market makers (decision 8). Empty: no maker quotes.
RFQ_MAKER_KEYS=
RFQ_WAIT_MS=700
INDEXER_BATCH_BLOCKS=2000
INDEXER_CONFIRMATIONS=2
# Reference prices for the website before a market is live (display only, src/lib/refPrices.ts). Free key from
# finnhub.io; empty turns them off. Secret: never commit it.
FINNHUB_API_KEY=
# Wallet verification (docs/ELIGIBILITY.md). deploy/mainnet.sh creates the attester key and the country database.
# The key is secret: never commit it. Its address must be roles.attester in deployments/4663.json.
ATTESTER_PRIVATE_KEY=
GEOIP_DB=/home/paritas/geo/country.mmdb

{
  "name": "@paritas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "indexer": "tsx --env-file=.env src/indexer.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fastify/websocket": "11.3.4",
    "@paritas/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "viem": "2.57.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

# Production builds (`next build`, `next start`) target Robinhood Chain mainnet. `next dev` keeps using .env.local
# (local anvil). Public values only: secrets never go in this file.
# Next.js lets .env.local override this file, so do not create .env.local on the server; put server-specific values
# (for example the WalletConnect project id) in .env.production.local instead.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Same origin: Nginx proxies /api (and its websockets) to Fastify on :4000, stripping the /api prefix.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# contracts/ (Foundry). The deployer key lives in a Foundry keystore:  cast wallet import paritas-deployer --interactive
# then: forge script script/Deploy.s.sol --rpc-url robinhood --account paritas-deployer --sender <address> --broadcast --verify
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
BLOCKSCOUT_API_KEY=
ENFORCE_ELIGIBILITY=false           # testnet only; mainnet always enforces
